  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo reference=\"camera_link\">\r\n  <sensor name=\"camera_frame_sensor\"
    type=\"depth\">\r\n    <always_on>true</always_on>\r\n    <update_rate>30.0</update_rate>\r\n   
    <camera>\r\n      <horizontal_fov>0.994837</horizontal_fov>\r\n      <image>\r\n       
    <format>R8G8B8</format>\r\n        <width>640</width>\r\n        <height>480</height>\r\n     
    </image>\r\n      <clip>\r\n        <near>0.01</near>\r\n        <far>10</far>\r\n     
    </clip>\r\n    </camera>\r\n    <plugin filename=\"libgazebo_ros_openni_kinect.so\"
    name=\"camera_frame_controller\">\r\n      <alwaysOn>true</alwaysOn>\r\n     
