  m_EditorClassIdentifier: 
  PluginText: "<gazebo reference=\"base_link\">\r\n  <mu1>0.3</mu1>\r\n  <mu2>0.3</mu2>\r\n 
    <sensor type=\"contact\" name=\"bumpers\">\r\n    <always_on>1</always_on>\r\n   
    <update_rate>50.0</update_rate>\r\n    <visualize>true</visualize>\r\n    <contact>\r\n     
    <collision>base_footprint</collision>\r\n    </contact>\r\n  </sensor>\r\n</gazebo>"
--- !u!114 &836113021
