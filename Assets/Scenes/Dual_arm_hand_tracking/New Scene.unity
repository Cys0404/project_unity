  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo reference=\"cliff_sensor_front_link\">\r\n  <sensor name=\"cliff_sensor_front\"
    type=\"ray\">\r\n    <always_on>true</always_on>\r\n    <update_rate>50</update_rate>\r\n   
    <visualize>true</visualize>\r\n    <ray>\r\n      <scan>\r\n        <horizontal>\r\n         
    <samples>50</samples>\r\n          <resolution>1.0</resolution>\r\n         
    <min_angle>-0.0436</min_angle>\r\n          <!-- -2.5 degree -->\r\n         
    <max_angle>0.0436</max_angle>\r\n          <!-- 2.5 degree -->\r\n        </horizontal>\r\n     
    </scan>\r\n      <range>\r\n        <min>0.01</min>\r\n        <max>0.15</max>\r\n       
    <resolution>1.0</resolution>\r\n      </range>\r\n    </ray>\r\n  </sensor>\r\n</gazebo>"
