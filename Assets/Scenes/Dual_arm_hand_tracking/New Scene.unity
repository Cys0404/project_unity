--- !u!114 &836113017
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 836113015}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo>\r\n  <plugin filename=\"libgazebo_ros_diff_drive.so\" name=\"differential_drive_controller\">\r\n   
    <alwaysOn>true</alwaysOn>\r\n    <legacyMode>false</legacyMode>\r\n    <updateRate>40</updateRate>\r\n   
    <leftJoint>wheel_left_joint</leftJoint>\r\n    <rightJoint>wheel_right_joint</rightJoint>\r\n   
    <wheelSeparation>0.230</wheelSeparation>\r\n    <wheelDiameter>0.070</wheelDiameter>\r\n   
    <wheelTorque>1.0</wheelTorque>\r\n    <!--wheelAcceleration>${wheel_accel}</wheelAcceleration-->\r\n   
    <commandTopic>mobile_base/commands/velocity</commandTopic>\r\n    <odometryTopic>odom</odometryTopic>\r\n   
    <odometryFrame>odom</odometryFrame>\r\n    <robotBaseFrame>base_footprint</robotBaseFrame>\r\n   
    <publishWheelJointState>true</publishWheelJointState>\r\n  </plugin>\r\n  <plugin
    filename=\"libgazebo_ros_p3d.so\" name=\"p3d_base_controller\">\r\n    <alwaysOn>true</alwaysOn>\r\n   
    <updateRate>100.0</updateRate>\r\n    <bodyName>base_link</bodyName>\r\n    <topicName>base/absolute_position</topicName>\r\n   
    <gaussianNoise>0</gaussianNoise>\r\n    <frameName>map</frameName>\r\n    <xyzOffsets>0
    0 0</xyzOffsets>\r\n    <rpyOffsets>0 0 0</rpyOffsets>\r\n    <!--<interface:position
    name=\"p3d_base_position\"/>-->\r\n  </plugin>\r\n</gazebo>"
