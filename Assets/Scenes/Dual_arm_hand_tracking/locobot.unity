  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo reference=\"camera_link\">\r\n  <sensor name=\"camera_frame_sensor\"
    type=\"depth\">\r\n    <always_on>true</always_on>\r\n    <update_rate>30.0</update_rate>\r\n   
    <camera>\r\n      <horizontal_fov>0.994837</horizontal_fov>\r\n      <image>\r\n       
    <format>R8G8B8</format>\r\n        <width>640</width>\r\n        <height>480</height>\r\n     
    </image>\r\n      <clip>\r\n        <near>0.01</near>\r\n        <far>10</far>\r\n     
    </clip>\r\n    </camera>\r\n    <plugin filename=\"libgazebo_ros_openni_kinect.so\"
    name=\"camera_frame_controller\">\r\n      <alwaysOn>true</alwaysOn>\r\n     
    <updateRate>30.0</updateRate>\r\n      <cameraName>camera</cameraName>\r\n     
    <imageTopicName>color/image_raw</imageTopicName>\r\n      <cameraInfoTopicName>color/camera_info</cameraInfoTopicName>\r\n     
    <depthImageTopicName>aligned_depth_to_color/image_raw</depthImageTopicName>\r\n     
    <depthImageCameraInfoTopicName>aligned_depth_to_color/camera_info</depthImageCameraInfoTopicName>\r\n     
    <pointCloudTopicName>depth_registered/points</pointCloudTopicName>\r\n      <frameName>camera_color_optical_frame</frameName>\r\n     
    <pointCloudCutoff>0</pointCloudCutoff>\r\n      <pointCloudCutoffMax>10.0</pointCloudCutoffMax>\r\n     
    <distortionK1>0.00000001</distortionK1>\r\n      <distortionK2>0.00000001</distortionK2>\r\n     
    <distortionK3>0.00000001</distortionK3>\r\n      <distortionT1>0.00000001</distortionT1>\r\n     
    <distortionT2>0.00000001</distortionT2>\r\n      <CxPrime>0</CxPrime>\r\n     
    <Cx>0</Cx>\r\n      <Cy>0</Cy>\r\n      <focalLength>0</focalLength>\r\n     
    <hackBaseline>0</hackBaseline>\r\n    </plugin>\r\n  </sensor>\r\n</gazebo>"
