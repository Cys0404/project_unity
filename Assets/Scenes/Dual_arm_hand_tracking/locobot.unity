--- !u!114 &594718781
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 594718777}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo reference=\"gyro_link\">\r\n  <sensor name=\"imu\" type=\"imu\">\r\n   
    <always_on>true</always_on>\r\n    <update_rate>50</update_rate>\r\n    <visualize>false</visualize>\r\n   
    <imu>\r\n      <noise>\r\n        <type>gaussian</type>\r\n        <rate>\r\n         
    <mean>0.0</mean>\r\n          <stddev>0.00000196</stddev>\r\n          <!-- 0.25
    x 0.25 (deg/s) -->\r\n          <bias_mean>0.0</bias_mean>\r\n          <bias_stddev>0.0</bias_stddev>\r\n       
    </rate>\r\n        <accel>\r\n          <!-- not used in the plugin and real
    robot, hence using tutorial values -->\r\n          <mean>0.0</mean>\r\n         
    <stddev>1.7e-2</stddev>\r\n          <bias_mean>0.1</bias_mean>\r\n         
    <bias_stddev>0.001</bias_stddev>\r\n        </accel>\r\n      </noise>\r\n   
    </imu>\r\n  </sensor>\r\n</gazebo>"
